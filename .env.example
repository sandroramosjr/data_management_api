# SQLite (padrão, nenhum setup necessário)
DATABASE_URL=sqlite:///./data.db

# PostgreSQL local (o serviço "db" do docker-compose expõe a porta 5432)
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/data_management

# Credenciais usadas pelo docker-compose (opcional; padrão: app / app / data_management)
# POSTGRES_USER=app
# POSTGRES_PASSWORD=app
# POSTGRES_DB=data_management

# Banco usado pelo pytest (padrão: SQLite em memória). O nome deve terminar em "_test".
# Defina como variável de ambiente do terminal (não é lida deste arquivo).
# TEST_DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/data_management_test
